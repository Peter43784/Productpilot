# --- LLM keys (optional; mock mode needs none) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Embeddings: auto (gemini if GEMINI_API_KEY set, else hash) | gemini | hash ---
# An explicit value also applies in mock mode (semantic memory without any LLM key).
# Re-seed memory after switching backends (vector dims differ): Remove-Item -Recurse -Force data\db; python seed_memory.py
PP_EMBEDDING_BACKEND=auto

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=productpilot

# --- ProductPilot behavior ---
# 1 = offline deterministic run (default), 0 = real LLM + tools
PRODUCTPILOT_MOCK=1
PP_MODEL_SONNET=claude-sonnet-4-5
PP_MODEL_HAIKU=claude-3-5-haiku-latest
PP_CRITIC_THRESHOLD=7.0
PP_MAX_REVISIONS=2
PP_TOP_THEMES=6
PP_TOP_OPTIONS=3
