# --- LLM keys (optional; mock mode needs none) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# --- Embeddings: local (sentence-transformers) ---
# Uses all-MiniLM-L6-v2 (384-dim, free, offline, no API key needed)
# PP_EMBEDDING_BACKEND=local

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=productpilot

# --- ProductPilot behavior ---
# 1 = offline deterministic run (default), 0 = real LLM + tools
PRODUCTPILOT_MOCK=1
PP_MODEL_SONNET=claude-sonnet-4-5
PP_MODEL_HAIKU=claude-haiku-4-5
PP_CRITIC_THRESHOLD=7.0
PP_MAX_REVISIONS=2
PP_TOP_THEMES=6
PP_TOP_OPTIONS=3
