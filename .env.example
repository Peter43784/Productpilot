# --- LLM keys (required) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# --- Embeddings: local (sentence-transformers) ---
# Uses all-MiniLM-L6-v2 (384-dim, free, offline, no API key needed)

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=productpilot

# --- ProductPilot behavior ---
PP_MODEL_SONNET=claude-sonnet-4-5
PP_MODEL_HAIKU=claude-haiku-4-5
PP_CRITIC_THRESHOLD=7.0
PP_MAX_REVISIONS=2
PP_TOP_THEMES=6
PP_TOP_OPTIONS=3
